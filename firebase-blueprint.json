{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private per-user profile, notification preferences, widget layout, and biometric lock configuration.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "eveningCutoffHour": { "type": "number" },
        "biometricEnabled": { "type": "boolean" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "expenseCategories": { "type": "array", "description": "Custom expense category labels (max 30)" },
        "budgetLimits": { "type": "object", "description": "Per-category monthly INR budget caps (max 30 entries)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "eveningCutoffHour", "biometricEnabled", "theme", "createdAt", "updatedAt"]
    },
    "DailyTask": {
      "title": "DailyTask",
      "description": "Personal daily task scheduled with evening cutoff tracking and reminder timing.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "notes": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["todo", "in_progress", "done"] },
        "dueDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "dueTime": { "type": "string", "maxLength": 5 },
        "assignedBeforeNight": { "type": "boolean" },
        "reminderEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "category", "priority", "status", "dueDate", "assignedBeforeNight", "reminderEnabled", "createdAt", "updatedAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "Personal daily habit with consecutive streak history, milestone tracking, grace days, and pause state.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "reminderTime": { "type": "string", "maxLength": 5 },
        "completedDates": { "type": "array", "description": "YYYY-MM-DD strings (max 366)" },
        "graceDates": { "type": "array", "description": "YYYY-MM-DD strings protected by grace shields (max 60)" },
        "graceTokensRemaining": { "type": "number" },
        "isPaused": { "type": "boolean" },
        "pauseReason": { "type": "string", "maxLength": 120 },
        "pausedSince": { "type": "string", "maxLength": 10 },
        "claimedMilestones": { "type": "array", "description": "Claimed milestone day numbers (max 10)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "category", "completedDates", "graceDates", "graceTokensRemaining", "isPaused", "claimedMilestones", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Private daily expense record per user for automated budget reporting and CSV export.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "amount": { "type": "number" },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "category", "amount", "date", "createdAt", "updatedAt"]
    },
    "SharedBoard": {
      "title": "SharedBoard",
      "description": "Multi-user collaborative workspace board.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 240 },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberIds": { "type": "array", "description": "Bounded list of member UIDs (max 25)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "memberIds", "createdAt", "updatedAt"]
    },
    "BoardItem": {
      "title": "BoardItem",
      "description": "Collaborative task card inside a shared team board.",
      "type": "object",
      "properties": {
        "boardId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberIds": { "type": "array", "description": "Bounded board member UIDs for secure list queries (max 25)" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "type": "string", "enum": ["backlog", "in_progress", "review", "done"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "assigneeName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "dueDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["boardId", "creatorId", "memberIds", "title", "status", "priority", "assigneeName", "dueDate", "createdAt", "updatedAt"]
    },
    "BoardComment": {
      "title": "BoardComment",
      "description": "Real-time internal team communication comment on a shared board.",
      "type": "object",
      "properties": {
        "boardId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberIds": { "type": "array", "description": "Bounded board member UIDs for secure list queries (max 25)" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "body": { "type": "string", "minLength": 1, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["boardId", "authorId", "memberIds", "authorName", "body", "createdAt"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Integrated team meeting or personal deadline synced on the workspace calendar.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantIds": { "type": "array", "description": "Bounded list of participant UIDs (max 25)" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "eventType": { "type": "string", "enum": ["meeting", "deadline", "reminder"] },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "startTime": { "type": "string", "maxLength": 5 },
        "endTime": { "type": "string", "maxLength": 5 },
        "urgent": { "type": "boolean" },
        "reminderMinutes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "participantIds", "title", "eventType", "date", "startTime", "urgent", "reminderMinutes", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user settings, evening cutoff, and biometric lock config."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/DailyTask" },
      "description": "Personal daily tasks with evening cutoff scheduling."
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": { "$ref": "#/entities/Habit" },
      "description": "Personal gamified habits with streak history, grace shields, and pause state."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Private daily expense ledger per user."
    },
    "/boards/{boardId}": {
      "schema": { "$ref": "#/entities/SharedBoard" },
      "description": "Shared multi-user project boards."
    },
    "/boards/{boardId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/BoardItem" },
      "description": "Tasks tracked inside a shared team board."
    },
    "/boards/{boardId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/BoardComment" },
      "description": "Real-time team communication feed inside a shared board."
    },
    "/calendarEvents/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "Unified calendar for team meetings and individual deadlines."
    }
  }
}
