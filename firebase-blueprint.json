{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private per-user profile, notification preferences, expense categories, budget caps, and biometric lock configuration. Strictly readable and writable only by the owner.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "eveningCutoffHour": { "type": "number" },
        "biometricEnabled": { "type": "boolean" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "expenseCategories": { "type": "array", "description": "Custom expense category labels (max 30)" },
        "budgetLimits": { "type": "object", "description": "Per-category monthly INR budget caps (max 30 entries)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "eveningCutoffHour", "biometricEnabled", "theme", "createdAt", "updatedAt"]
    },
    "SharedProfile": {
      "title": "SharedProfile",
      "description": "Non-PII split profile allowing explicitly connected family members read-only visibility into display name, categories, and monthly budget caps without exposing private account details or email.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "expenseCategories": { "type": "array", "description": "Custom expense category labels (max 30)" },
        "budgetLimits": { "type": "object", "description": "Per-category monthly INR budget caps (max 30 entries)" },
        "viewerIds": { "type": "array", "description": "Connected user UIDs granted read-only access (max 25)" },
        "viewerNames": { "type": "object", "description": "Display names for connected viewer UIDs (max 25 entries)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "displayName", "viewerIds", "createdAt", "updatedAt"]
    },
    "ShareInvite": {
      "title": "ShareInvite",
      "description": "Single-use invite code for mutually linking two signed-in user accounts for read-only viewing across devices.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 6, "maxLength": 16, "pattern": "^[A-Z0-9]+$" },
        "creatorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "type": "string", "enum": ["open", "accepted"] },
        "acceptedByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "acceptedByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "creatorId", "creatorName", "status", "createdAt", "updatedAt"]
    },
    "DailyTask": {
      "title": "DailyTask",
      "description": "Personal daily task scheduled with evening cutoff tracking. Owner can edit; connected viewerIds have read-only access.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "viewerIds": { "type": "array", "description": "Connected user UIDs granted read-only access (max 25)" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "notes": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["todo", "in_progress", "done"] },
        "dueDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "dueTime": { "type": "string", "maxLength": 5 },
        "assignedBeforeNight": { "type": "boolean" },
        "reminderEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "category", "priority", "status", "dueDate", "assignedBeforeNight", "reminderEnabled", "createdAt", "updatedAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "Personal daily habit with consecutive streak history, milestone tracking, grace days, and pause state. Owner can edit; connected viewerIds have read-only access.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "viewerIds": { "type": "array", "description": "Connected user UIDs granted read-only access (max 25)" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "reminderTime": { "type": "string", "maxLength": 5 },
        "completedDates": { "type": "array", "description": "YYYY-MM-DD strings (max 366)" },
        "graceDates": { "type": "array", "description": "YYYY-MM-DD strings protected by grace shields (max 60)" },
        "graceTokensRemaining": { "type": "number" },
        "isPaused": { "type": "boolean" },
        "pauseReason": { "type": "string", "maxLength": 120 },
        "pausedSince": { "type": "string", "maxLength": 10 },
        "claimedMilestones": { "type": "array", "description": "Claimed milestone day numbers (max 10)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "category", "completedDates", "graceDates", "graceTokensRemaining", "isPaused", "claimedMilestones", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Daily expense record per user for automated budget reporting and CSV export. Owner can edit; connected viewerIds have read-only access.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "viewerIds": { "type": "array", "description": "Connected user UIDs granted read-only access (max 25)" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "amount": { "type": "number" },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "category", "amount", "date", "createdAt", "updatedAt"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Integrated calendar event synced across devices. Owner can edit; connected participantIds have read-only visibility.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantIds": { "type": "array", "description": "Owner and connected viewer UIDs (max 25)" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "eventType": { "type": "string", "enum": ["meeting", "deadline", "reminder"] },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "startTime": { "type": "string", "maxLength": 5 },
        "endTime": { "type": "string", "maxLength": 5 },
        "urgent": { "type": "boolean" },
        "reminderMinutes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "participantIds", "title", "eventType", "date", "startTime", "urgent", "reminderMinutes", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user settings, email PII, evening cutoff, and biometric lock config (owner-only)."
    },
    "/sharedProfiles/{profileId}": {
      "schema": { "$ref": "#/entities/SharedProfile" },
      "description": "Non-PII display profile and budget configuration readable by explicitly connected family viewers."
    },
    "/shareInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/ShareInvite" },
      "description": "Single-use invite codes for linking two signed-in user accounts for mutual read-only viewing."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/DailyTask" },
      "description": "Daily tasks (owner read/write; connected viewerIds read-only)."
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": { "$ref": "#/entities/Habit" },
      "description": "Gamified habits with streak history (owner read/write; connected viewerIds read-only)."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Daily expense ledger (owner read/write; connected viewerIds read-only)."
    },
    "/calendarEvents/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "Unified calendar events (owner read/write; connected participantIds read-only)."
    }
  }
}
