rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateStr(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeStr(val) {
      return val is string && val.size() <= 5 && (val.size() == 0 || val.matches('^[0-9]{2}:[0-9]{2}$'));
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isBoundedIntList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is int);
    }

    // --- Validation Blueprints (Pillar 2) ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'eveningCutoffHour', 'biometricEnabled', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'eveningCutoffHour', 'biometricEnabled', 'theme', 'expenseCategories', 'budgetLimits', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.eveningCutoffHour is int && data.eveningCutoffHour >= 17 && data.eveningCutoffHour <= 23
        && data.biometricEnabled is bool
        && data.theme is string && data.theme in ['light', 'dark']
        && (!('expenseCategories' in data) || isBoundedStringList(data.expenseCategories, 30))
        && (!('budgetLimits' in data) || (data.budgetLimits is map && data.budgetLimits.size() <= 30))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['ownerId', 'title', 'category', 'priority', 'status', 'dueDate', 'assignedBeforeNight', 'reminderEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'notes', 'category', 'priority', 'status', 'dueDate', 'dueTime', 'assignedBeforeNight', 'reminderEnabled', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.priority is string && data.priority in ['low', 'medium', 'high', 'urgent']
        && data.status is string && data.status in ['todo', 'in_progress', 'done']
        && isValidDateStr(data.dueDate)
        && (!('dueTime' in data) || isValidTimeStr(data.dueTime))
        && data.assignedBeforeNight is bool
        && data.reminderEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHabit(data) {
      return data.keys().hasAll(['ownerId', 'name', 'category', 'completedDates', 'graceDates', 'graceTokensRemaining', 'isPaused', 'claimedMilestones', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'category', 'reminderTime', 'completedDates', 'graceDates', 'graceTokensRemaining', 'isPaused', 'pauseReason', 'pausedSince', 'claimedMilestones', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && (!('reminderTime' in data) || isValidTimeStr(data.reminderTime))
        && isBoundedStringList(data.completedDates, 366)
        && isBoundedStringList(data.graceDates, 60)
        && data.graceTokensRemaining is int && data.graceTokensRemaining >= 0 && data.graceTokensRemaining <= 10
        && data.isPaused is bool
        && (!('pauseReason' in data) || (data.pauseReason is string && data.pauseReason.size() <= 120))
        && (!('pausedSince' in data) || (data.pausedSince is string && data.pausedSince.size() <= 10))
        && isBoundedIntList(data.claimedMilestones, 10)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['ownerId', 'title', 'category', 'amount', 'date', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'category', 'amount', 'date', 'note', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.amount is number && data.amount > 0 && data.amount <= 1000000
        && isValidDateStr(data.date)
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoard(data) {
      return data.keys().hasAll(['name', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'description', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 240))
        && data.ownerId is string && isValidId(data.ownerId)
        && isBoundedStringList(data.memberIds, 25)
        && data.memberIds.size() >= 1
        && data.ownerId in data.memberIds
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardItem(data, boardId) {
      return data.keys().hasAll(['boardId', 'creatorId', 'memberIds', 'title', 'status', 'priority', 'assigneeName', 'dueDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['boardId', 'creatorId', 'memberIds', 'title', 'status', 'priority', 'assigneeName', 'dueDate', 'createdAt', 'updatedAt'])
        && data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.creatorId is string && isValidId(data.creatorId)
        && isBoundedStringList(data.memberIds, 25) && data.memberIds.size() >= 1
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.status is string && data.status in ['backlog', 'in_progress', 'review', 'done']
        && data.priority is string && data.priority in ['low', 'medium', 'high', 'urgent']
        && data.assigneeName is string && data.assigneeName.size() >= 1 && data.assigneeName.size() <= 60
        && isValidDateStr(data.dueDate)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardComment(data, boardId) {
      return data.keys().hasAll(['boardId', 'authorId', 'memberIds', 'authorName', 'body', 'createdAt'])
        && data.keys().hasOnly(['boardId', 'authorId', 'memberIds', 'authorName', 'body', 'createdAt'])
        && data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.authorId is string && data.authorId == request.auth.uid && isValidId(data.authorId)
        && isBoundedStringList(data.memberIds, 25) && data.memberIds.size() >= 1
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 400
        && data.createdAt is timestamp;
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasAll(['ownerId', 'participantIds', 'title', 'eventType', 'date', 'startTime', 'urgent', 'reminderMinutes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'participantIds', 'title', 'eventType', 'date', 'startTime', 'endTime', 'urgent', 'reminderMinutes', 'createdAt', 'updatedAt'])
        && data.ownerId is string && isValidId(data.ownerId)
        && isBoundedStringList(data.participantIds, 25)
        && data.ownerId in data.participantIds
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.eventType is string && data.eventType in ['meeting', 'deadline', 'reminder']
        && isValidDateStr(data.date)
        && isValidTimeStr(data.startTime)
        && (!('endTime' in data) || isValidTimeStr(data.endTime))
        && data.urgent is bool
        && data.reminderMinutes is int && data.reminderMinutes >= 0 && data.reminderMinutes <= 1440
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isBoardMember(boardId) {
      return exists(/databases/$(database)/documents/boards/$(boardId))
        && request.auth.uid in get(/databases/$(database)/documents/boards/$(boardId)).data.memberIds;
    }

    function matchesParentMembers(boardId, memberIds) {
      return exists(/databases/$(database)/documents/boards/$(boardId))
        && get(/databases/$(database)/documents/boards/$(boardId)).data.memberIds == memberIds;
    }

    // --- Private User Profile & Subcollections (PII Isolated) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'eveningCutoffHour', 'biometricEnabled', 'theme', 'expenseCategories', 'budgetLimits', 'updatedAt']);
      allow delete: if isVerified() && isValidId(userId) && isOwner(userId);

      match /tasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(taskId) && isOwner(userId)
          && isValidTask(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(userId) && isValidId(taskId) && isOwner(userId)
          && isValidTask(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes', 'category', 'priority', 'status', 'dueDate', 'dueTime', 'assignedBeforeNight', 'reminderEnabled', 'updatedAt'])
          );
        allow delete: if isVerified() && isValidId(userId) && isValidId(taskId) && isOwner(userId);
      }

      match /habits/{habitId} {
        allow get: if isValidId(userId) && isValidId(habitId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(habitId) && isOwner(userId)
          && isValidHabit(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(userId) && isValidId(habitId) && isOwner(userId)
          && isValidHabit(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['completedDates', 'claimedMilestones', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['graceDates', 'graceTokensRemaining', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['isPaused', 'pauseReason', 'pausedSince', 'graceDates', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'reminderTime', 'updatedAt'])
          );
        allow delete: if isVerified() && isValidId(userId) && isValidId(habitId) && isOwner(userId);
      }

      match /expenses/{expenseId} {
        allow get: if isValidId(userId) && isValidId(expenseId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(expenseId) && isOwner(userId)
          && isValidExpense(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(userId) && isValidId(expenseId) && isOwner(userId)
          && isValidExpense(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'amount', 'date', 'note', 'updatedAt']);
        allow delete: if isVerified() && isValidId(userId) && isValidId(expenseId) && isOwner(userId);
      }
    }

    // --- Shared Multi-User Team Boards ---
    match /boards/{boardId} {
      allow get: if isSignedIn() && isValidId(boardId) && request.auth.uid in existing().memberIds;
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isVerified() && isValidId(boardId)
        && isValidBoard(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(boardId)
        && isValidBoard(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'memberIds', 'updatedAt']);
      allow delete: if isVerified() && isValidId(boardId) && existing().ownerId == request.auth.uid;

      match /items/{itemId} {
        allow get: if isSignedIn() && isValidId(boardId) && isValidId(itemId) && isBoardMember(boardId);
        allow list: if isSignedIn() && resource.data.boardId == boardId && request.auth.uid in resource.data.memberIds;
        allow create: if isVerified() && isValidId(boardId) && isValidId(itemId)
          && isValidBoardItem(incoming(), boardId)
          && incoming().creatorId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isBoardMember(boardId)
          && matchesParentMembers(boardId, incoming().memberIds);
        allow update: if isVerified() && isValidId(boardId) && isValidId(itemId)
          && isValidBoardItem(incoming(), boardId)
          && incoming().boardId == existing().boardId
          && incoming().creatorId == existing().creatorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isBoardMember(boardId)
          && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
            || (existing().creatorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'status', 'priority', 'assigneeName', 'dueDate', 'memberIds', 'updatedAt']))
          );
        allow delete: if isVerified() && isValidId(boardId) && isValidId(itemId)
          && existing().creatorId == request.auth.uid
          && isBoardMember(boardId);
      }

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(boardId) && isValidId(commentId) && isBoardMember(boardId);
        allow list: if isSignedIn() && resource.data.boardId == boardId && request.auth.uid in resource.data.memberIds;
        allow create: if isVerified() && isValidId(boardId) && isValidId(commentId)
          && isValidBoardComment(incoming(), boardId)
          && incoming().createdAt == request.time
          && isBoardMember(boardId)
          && matchesParentMembers(boardId, incoming().memberIds);
        allow update: if false;
        allow delete: if isVerified() && isValidId(boardId) && isValidId(commentId)
          && existing().authorId == request.auth.uid
          && isBoardMember(boardId);
      }
    }

    // --- Integrated Calendar (Team Meetings & Individual Deadlines) ---
    match /calendarEvents/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId)
        && (existing().ownerId == request.auth.uid || request.auth.uid in existing().participantIds);
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.participantIds);
      allow create: if isVerified() && isValidId(eventId)
        && isValidCalendarEvent(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(eventId)
        && isValidCalendarEvent(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'eventType', 'date', 'startTime', 'endTime', 'urgent', 'reminderMinutes', 'participantIds', 'updatedAt']);
      allow delete: if isVerified() && isValidId(eventId) && existing().ownerId == request.auth.uid;
    }
  }
}
