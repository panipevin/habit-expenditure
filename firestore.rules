rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 16 && code.matches('^[A-Z0-9]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateStr(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeStr(val) {
      return val is string && val.size() <= 5 && (val.size() == 0 || val.matches('^[0-9]{2}:[0-9]{2}$'));
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isBoundedIntList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is int);
    }

    // --- Validation Blueprints (Pillar 2) ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'eveningCutoffHour', 'biometricEnabled', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'eveningCutoffHour', 'biometricEnabled', 'theme', 'expenseCategories', 'budgetLimits', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.eveningCutoffHour is int && data.eveningCutoffHour >= 17 && data.eveningCutoffHour <= 23
        && data.biometricEnabled is bool
        && data.theme is string && data.theme in ['light', 'dark']
        && (!('expenseCategories' in data) || isBoundedStringList(data.expenseCategories, 30))
        && (!('budgetLimits' in data) || (data.budgetLimits is map && data.budgetLimits.size() <= 30))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSharedProfile(data) {
      return data.keys().hasAll(['ownerId', 'displayName', 'viewerIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'expenseCategories', 'budgetLimits', 'viewerIds', 'viewerNames', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('expenseCategories' in data) || isBoundedStringList(data.expenseCategories, 30))
        && (!('budgetLimits' in data) || (data.budgetLimits is map && data.budgetLimits.size() <= 30))
        && isBoundedStringList(data.viewerIds, 25)
        && (!('viewerNames' in data) || (data.viewerNames is map && data.viewerNames.size() <= 25))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidShareInvite(data, inviteCode) {
      return data.keys().hasAll(['code', 'creatorId', 'creatorName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'creatorId', 'creatorName', 'status', 'acceptedByUid', 'acceptedByName', 'createdAt', 'updatedAt'])
        && data.code is string && data.code == inviteCode && isValidInviteCode(data.code)
        && data.creatorId is string && isValidId(data.creatorId)
        && data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80
        && data.status is string && data.status in ['open', 'accepted']
        && (!('acceptedByUid' in data) || (data.acceptedByUid is string && isValidId(data.acceptedByUid)))
        && (!('acceptedByName' in data) || (data.acceptedByName is string && data.acceptedByName.size() >= 1 && data.acceptedByName.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['ownerId', 'title', 'category', 'priority', 'status', 'dueDate', 'assignedBeforeNight', 'reminderEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'viewerIds', 'title', 'notes', 'category', 'priority', 'status', 'dueDate', 'dueTime', 'assignedBeforeNight', 'reminderEnabled', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && (!('viewerIds' in data) || isBoundedStringList(data.viewerIds, 25))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.priority is string && data.priority in ['low', 'medium', 'high', 'urgent']
        && data.status is string && data.status in ['todo', 'in_progress', 'done']
        && isValidDateStr(data.dueDate)
        && (!('dueTime' in data) || isValidTimeStr(data.dueTime))
        && data.assignedBeforeNight is bool
        && data.reminderEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHabit(data) {
      return data.keys().hasAll(['ownerId', 'name', 'category', 'completedDates', 'graceDates', 'graceTokensRemaining', 'isPaused', 'claimedMilestones', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'viewerIds', 'name', 'category', 'reminderTime', 'completedDates', 'graceDates', 'graceTokensRemaining', 'isPaused', 'pauseReason', 'pausedSince', 'claimedMilestones', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && (!('viewerIds' in data) || isBoundedStringList(data.viewerIds, 25))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && (!('reminderTime' in data) || isValidTimeStr(data.reminderTime))
        && isBoundedStringList(data.completedDates, 366)
        && isBoundedStringList(data.graceDates, 60)
        && data.graceTokensRemaining is int && data.graceTokensRemaining >= 0 && data.graceTokensRemaining <= 10
        && data.isPaused is bool
        && (!('pauseReason' in data) || (data.pauseReason is string && data.pauseReason.size() <= 120))
        && (!('pausedSince' in data) || (data.pausedSince is string && data.pausedSince.size() <= 10))
        && isBoundedIntList(data.claimedMilestones, 10)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['ownerId', 'title', 'category', 'amount', 'date', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'viewerIds', 'title', 'category', 'amount', 'date', 'note', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && (!('viewerIds' in data) || isBoundedStringList(data.viewerIds, 25))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.amount is number && data.amount > 0 && data.amount <= 1000000
        && isValidDateStr(data.date)
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasAll(['ownerId', 'participantIds', 'title', 'eventType', 'date', 'startTime', 'urgent', 'reminderMinutes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'participantIds', 'title', 'eventType', 'date', 'startTime', 'endTime', 'urgent', 'reminderMinutes', 'createdAt', 'updatedAt'])
        && data.ownerId is string && isValidId(data.ownerId)
        && isBoundedStringList(data.participantIds, 25)
        && data.ownerId in data.participantIds
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.eventType is string && data.eventType in ['meeting', 'deadline', 'reminder']
        && isValidDateStr(data.date)
        && isValidTimeStr(data.startTime)
        && (!('endTime' in data) || isValidTimeStr(data.endTime))
        && data.urgent is bool
        && data.reminderMinutes is int && data.reminderMinutes >= 0 && data.reminderMinutes <= 1440
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Private User Profile (Strictly Owner-Only PII Isolation) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'eveningCutoffHour', 'biometricEnabled', 'theme', 'expenseCategories', 'budgetLimits', 'updatedAt']);
      allow delete: if isVerified() && isValidId(userId) && isOwner(userId);

      // Personal Tasks: Owner read/write; connected viewerIds read-only
      match /tasks/{taskId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(taskId)
          && (isOwner(userId) || ('viewerIds' in existing() && request.auth.uid in existing().viewerIds));
        allow list: if isSignedIn()
          && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.viewerIds);
        allow create: if isVerified() && isValidId(userId) && isValidId(taskId) && isOwner(userId)
          && isValidTask(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(userId) && isValidId(taskId) && isOwner(userId)
          && isValidTask(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['viewerIds', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes', 'category', 'priority', 'status', 'dueDate', 'dueTime', 'assignedBeforeNight', 'reminderEnabled', 'viewerIds', 'updatedAt'])
          );
        allow delete: if isVerified() && isValidId(userId) && isValidId(taskId) && isOwner(userId);
      }

      // Personal Habits: Owner read/write; connected viewerIds read-only
      match /habits/{habitId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(habitId)
          && (isOwner(userId) || ('viewerIds' in existing() && request.auth.uid in existing().viewerIds));
        allow list: if isSignedIn()
          && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.viewerIds);
        allow create: if isVerified() && isValidId(userId) && isValidId(habitId) && isOwner(userId)
          && isValidHabit(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(userId) && isValidId(habitId) && isOwner(userId)
          && isValidHabit(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['completedDates', 'claimedMilestones', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['graceDates', 'graceTokensRemaining', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['isPaused', 'pauseReason', 'pausedSince', 'graceDates', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['viewerIds', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'reminderTime', 'viewerIds', 'updatedAt'])
          );
        allow delete: if isVerified() && isValidId(userId) && isValidId(habitId) && isOwner(userId);
      }

      // Personal Expenses: Owner read/write; connected viewerIds read-only
      match /expenses/{expenseId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(expenseId)
          && (isOwner(userId) || ('viewerIds' in existing() && request.auth.uid in existing().viewerIds));
        allow list: if isSignedIn()
          && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.viewerIds);
        allow create: if isVerified() && isValidId(userId) && isValidId(expenseId) && isOwner(userId)
          && isValidExpense(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(userId) && isValidId(expenseId) && isOwner(userId)
          && isValidExpense(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['viewerIds', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'amount', 'date', 'note', 'viewerIds', 'updatedAt'])
          );
        allow delete: if isVerified() && isValidId(userId) && isValidId(expenseId) && isOwner(userId);
      }
    }

    // --- Non-PII Split Shared Profiles (Read-Only for Connected Family Viewers) ---
    match /sharedProfiles/{profileId} {
      allow get: if isSignedIn() && isValidId(profileId)
        && (isOwner(profileId) || request.auth.uid in existing().viewerIds);
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.viewerIds);
      allow create: if isVerified() && isValidId(profileId) && isOwner(profileId)
        && isValidSharedProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(profileId) && isOwner(profileId)
        && isValidSharedProfile(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'expenseCategories', 'budgetLimits', 'viewerIds', 'viewerNames', 'updatedAt']);
      allow delete: if isVerified() && isValidId(profileId) && isOwner(profileId);
    }

    // --- Single-Use Family Connection Invite Codes (Terminal State Locked) ---
    match /shareInvites/{inviteCode} {
      allow get: if isSignedIn() && isValidInviteCode(inviteCode);
      allow list: if isSignedIn()
        && (resource.data.creatorId == request.auth.uid || resource.data.acceptedByUid == request.auth.uid);
      allow create: if isVerified() && isValidInviteCode(inviteCode)
        && isValidShareInvite(incoming(), inviteCode)
        && incoming().creatorId == request.auth.uid
        && incoming().status == 'open'
        && !('acceptedByUid' in incoming())
        && !('acceptedByName' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidInviteCode(inviteCode)
        && isValidShareInvite(incoming(), inviteCode)
        && existing().status == 'open'
        && incoming().status == 'accepted'
        && existing().creatorId != request.auth.uid
        && incoming().creatorId == existing().creatorId
        && incoming().creatorName == existing().creatorName
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().acceptedByUid == request.auth.uid
        && ('acceptedByName' in incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'acceptedByName', 'updatedAt']);
      allow delete: if isVerified() && isValidInviteCode(inviteCode)
        && (existing().creatorId == request.auth.uid || existing().acceptedByUid == request.auth.uid);
    }

    // --- Integrated Calendar (Owner Read/Write; Connected ParticipantIds Read-Only) ---
    match /calendarEvents/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId)
        && (existing().ownerId == request.auth.uid || request.auth.uid in existing().participantIds);
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.participantIds);
      allow create: if isVerified() && isValidId(eventId)
        && isValidCalendarEvent(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(eventId)
        && isValidCalendarEvent(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'eventType', 'date', 'startTime', 'endTime', 'urgent', 'reminderMinutes', 'participantIds', 'updatedAt'])
        );
      allow delete: if isVerified() && isValidId(eventId) && existing().ownerId == request.auth.uid;
    }
  }
}
